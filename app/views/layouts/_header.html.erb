
<header class="bg-white border-b border-gray-200">
  <div class="mx-auto max-w-7xl px-4">
    <div class="flex h-20 items-center justify-between">

      <!-- Airbnb Logo -->
      <div>
        <%= link_to "Airbnb", root_path,
          class: "text-2xl font-bold text-rose-500" %>
      </div>

      <!-- Basic Search Bar -->
      <div class="flex items-center rounded-full border border-gray-300 shadow-sm px-4 py-2">
        <input
          type="text"
          placeholder="Search destinations"
          class="w-40 border-0 outline-none focus:ring-0 text-sm"
        >
        <button class="ml-2 rounded-full bg-rose-500 p-2 text-white">
          Search
        </button>
      </div>

      <!-- Basic Navigation -->
      <div class="flex items-center gap-4">
        <%= link_to "Home", root_path,
          class: "text-sm font-medium text-gray-700 hover:text-rose-500" %>

        <%= link_to "Explore", root_path,
          class: "text-sm font-medium text-gray-700 hover:text-rose-500" %>
      </div>

    </div>
  </div>
</header>
